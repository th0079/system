# DB Tier 설정 : MariaDB 를 VM 내부(127.0.0.1)에서만 접속할 수 있게 제한한다.
# 호스트 OS 나 외부에서는 3306 포트로 직접 접속할 수 없고, 같은 VM 의 WAS 만 접속한다.
#   Ubuntu : /etc/mysql/mariadb.conf.d/60-loginapp.cnf
#   Rocky  : /etc/my.cnf.d/zz-loginapp.cnf   (마지막에 읽히도록 zz- 접두어)
[mysqld]
bind-address         = 127.0.0.1
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci
